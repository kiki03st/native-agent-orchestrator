{
  "description": "Native Claude orchestration with plugin-scoped model and effort profiles.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: PostToolUseFailure"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^native-agent-orchestrator:orch-",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^native-agent-orchestrator:orch-",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Native Agent Orchestrator: SubagentStop"
          }
        ]
      }
    ]
  }
}
